{
  "manifest_version": 3,
  "name": "Adelaide",
  "version": "0.3.0",
  "description": "A storage-auction watchlist. Saves listings you choose, and never does anything on its own.",
  "action": {
    "default_title": "Adelaide",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.storagetreasures.com/*",
    "https://bid13.com/*"
  ]
}
